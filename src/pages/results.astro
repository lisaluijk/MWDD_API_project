---
// @ts-nocheck
import "../styles/style.css";

export const prerender = false;

const discogsKey = import.meta.env.DISCOG_TOKEN;
const userName = "lisa_luijk";
const discogsURL = `https://api.discogs.com/users/${userName}/collection/folders/0/releases?token=${discogsKey}&per_page=100&sort=artist`;
const response = await fetch(discogsURL);
const data = await response.json();
const records = data.releases;

// source gpt
const url = Astro.url;
// const url = document.url;

// get data from url
const chosenGenres = url.searchParams.getAll("genres");
const time = url.searchParams.get("listenTime");

// filtering on genres
const filtered = records.filter((record) => {
	const recordGenres = record.basic_information.genres || [];
	return chosenGenres.some((g) => recordGenres.includes(g));
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Results</title>
	</head>
	<body>
		<div class="windowBox px-corners-m">
			<span class="px-corners-s">your_personal_playlist.mp3</span>
			<div class="px-corners-s content">
				<a href="/" class="backLink">◄ go back</a>
				<h1>Here is your record playlist!</h1>

				<p>
					A personalized playlist of <b>{time}</b> records with at least
					one of the following genres: <b>{chosenGenres.join(", ")}</b
					>.
				</p>

				<button id="visualizerBtn">▶</button>

				<!-- one canvas, visible for now -->
				<canvas id="visualizerCanvas" style="display:none;"></canvas>
				<video
					id="visualizerVideo"
					style="display:none;"
					muted
					playsinline></video>

				<!-- where the records get loaded in -->
				<ul id="recordList"></ul>
			</div>
		</div>

		<script define:vars={{ records, url, chosenGenres, time, filtered }}>
			// @ts-nocheck

			const recordsList = document.querySelector("#recordList");
			let displayRecords = records;

			const list = document.querySelector("#recordList");

			// aantal platen laten zien omzetten van string naar integer
			recordAmount = parseInt(time);

			// shuffelen door telkens twee records met elkaar te swappen en een soort deconstruct iets om code lines te besparen.
			function shuffle(arr) {
				// ... = spread operator?
				// used to make a copy otherwise you are referencing to the same array with different variables
				const copy = [...arr];

				// ga door de array heen en wissel telkens een record met een andere record
				for (let i = copy.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));

					// array destructuring assignment(?) basically scheelt lines of code omdat je het kan swappen terwijl het wel op elkaar berust zeg maar, beetje de css vibes met dat swappen
					[copy[i], copy[j]] = [copy[j], copy[i]];
				}

				return copy;
			}

			const shuffledRecords = shuffle(filtered);
			console.log(shuffledRecords);

			const selectedRecords = shuffledRecords.slice(0, recordAmount);

			selectedRecords.forEach((record) => {
				const li = document.createElement("li");

				const img = document.createElement("img");
				img.src = record.basic_information.cover_image;
				img.alt = record.basic_information.title;

				const info = document.createElement("div");
				info.classList.add("record-info");

				const titleInformation = document.createElement("div");
				titleInformation.classList.add("title-information");

				const title = document.createElement("h2");
				title.textContent = record.basic_information.title;

				const artist = document.createElement("p");
				artist.textContent = record.basic_information.artists
					?.map((artist) => artist.name)
					.join(", ");

				const year = document.createElement("p");
				year.textContent = record.basic_information.year;

				titleInformation.appendChild(title);
				titleInformation.appendChild(artist);
				titleInformation.appendChild(year);

				const genreInformation = document.createElement("div");
				genreInformation.classList.add("genre-information");

				const genres = document.createElement("p");
				genres.textContent =
					record.basic_information.genres?.join(", ");

				const genresLabel = document.createElement("strong");
				genresLabel.textContent = "genres:";

				genreInformation.appendChild(genresLabel);
				genreInformation.appendChild(genres);

				info.appendChild(titleInformation);
				info.appendChild(genreInformation);

				const imageContainer = document.createElement("div");
				imageContainer.classList.add("record-image");
				imageContainer.classList.add("px-corners-s");

				imageContainer.appendChild(img);

				li.appendChild(imageContainer);
				li.appendChild(info);

				list.appendChild(li);
			});
			// console.log(displayRecords);

			// get track duration
			// const masterURL = record.basic_information.master_url;
			// console.log(masterURL);

			// async function getTrackDuration() {
			// 	const masterResponse = await fetch(masterURL);
			// 	const masterData = await masterResponse.json();
			// 	const masterInformation = masterData.releases;
			// }

			// getTrackDuration();
			// console.log(masterInformation)

			// carrousel code

			// carrousel code
			// recordslist is container and recordslistitems are items
			//

			const recordsListItems =
				document.querySelectorAll("#recordList > *");

			console.log(recordsListItems);

			let ticking = false;

			function updateActive() {
				const isMobile =
					window.matchMedia("(max-width: 600px)").matches;

				const listRect = recordsList.getBoundingClientRect();

				let listCenter;

				if (isMobile) {
					listCenter = listRect.top + listRect.height / 2;
				} else {
					listCenter = listRect.left + listRect.width / 2;
				}

				recordsListItems.forEach((item) => {
					const itemRect = item.getBoundingClientRect();

					let itemCenter;

					if (isMobile) {
						itemCenter = itemRect.top + itemRect.height / 2;
					} else {
						itemCenter = itemRect.left + itemRect.width / 2;
					}

					const distance = Math.abs(listCenter - itemCenter);

					if (
						distance <
						(isMobile ? itemRect.height : itemRect.width) / 2
					) {
						item.classList.add("is-active");
					} else {
						item.classList.remove("is-active");
					}
				});

				ticking = false;
			}

			function requestUpdate() {
				if (!ticking) {
					requestAnimationFrame(updateActive);
					ticking = true;
				}
			}

			updateActive();

			recordsList.addEventListener("scroll", requestUpdate);

			// ==========================================================================
			// MARK: Visualizer — mic input + canvas drawing (Web Audio API + Canvas API)
			// ==========================================================================

			const visualizerBtn = document.querySelector("#visualizerBtn");
			const canvas = document.querySelector("#visualizerCanvas");
			const video = document.querySelector("#visualizerVideo");
			const ctx = canvas.getContext("2d");

			canvas.width = 480;
			canvas.height = 270;

			// 8bit palette — maps low to high amplitude
			// const BAR_COLORS = ["#6894b7", "#a78ee9", "#d1c0fa", "#ff77c8"];

			let audioCtx, analyser, source, animFrameId;
			let isRunning = false;

			// function getBarColor(value) {
			// 	if (value < 64) return BAR_COLORS[0]; // blue
			// 	if (value < 128) return BAR_COLORS[1]; // purple
			// 	if (value < 192) return BAR_COLORS[2]; // light purple
			// 	return BAR_COLORS[3]; // pink
			// }

			function drawVisualizerWindow() {
				const padding = 8;
				const labelHeight = 28;
				const gap = 5;

				// Main light window background
				ctx.fillStyle = "#f2f2eb";
				ctx.fillRect(0, 0, canvas.width, canvas.height);

				// Dark outer border
				ctx.strokeStyle = "#414047";
				ctx.lineWidth = 2;
				ctx.strokeRect(1, 1, canvas.width - 2, canvas.height - 2);

				// White top and left highlight
				ctx.strokeStyle = "#fdfdfd";
				ctx.beginPath();
				ctx.moveTo(3, canvas.height - 3);
				ctx.lineTo(3, 3);
				ctx.lineTo(canvas.width - 3, 3);
				ctx.stroke();

				// Grey bottom and right shadow
				ctx.strokeStyle = "#ddd9d4";
				ctx.beginPath();
				ctx.moveTo(canvas.width - 3, 3);
				ctx.lineTo(canvas.width - 3, canvas.height - 3);
				ctx.lineTo(3, canvas.height - 3);
				ctx.stroke();

				// Blue title bar
				ctx.fillStyle = "#6894b7";
				ctx.fillRect(
					padding,
					padding,
					canvas.width - padding * 2,
					labelHeight,
				);

				// Title-bar border
				ctx.strokeStyle = "#414047";
				ctx.lineWidth = 1;
				ctx.strokeRect(
					padding,
					padding,
					canvas.width - padding * 2,
					labelHeight,
				);

				// Title text
				ctx.fillStyle = "#ffffff";
				ctx.font = "12px monospace";
				ctx.fillText("visualizer.exe", padding + 8, padding + 18);

				// Return the area where the equalizer should be drawn
				return {
					x: padding,
					y: padding + labelHeight + gap,
					width: canvas.width - padding * 2,
					height: canvas.height - (padding * 2 + labelHeight + gap),
				};
			}

			function drawEqualizer(dataArray) {
				const chart = drawVisualizerWindow();

				// Dark equalizer screen
				ctx.fillStyle = "#f2f2eb";
				ctx.fillRect(chart.x, chart.y, chart.width, chart.height);

				// Dashed baseline
				const baseline = chart.y + chart.height * 0.75;

				ctx.setLineDash([6, 4]);
				ctx.strokeStyle = "#414047";
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.moveTo(chart.x, baseline);
				ctx.lineTo(chart.x + chart.width, baseline);
				ctx.stroke();
				ctx.setLineDash([]);

				const barCount = 24;
				const barGap = 2;
				const barWidth = Math.floor(chart.width / barCount) - barGap;
				const step = Math.floor(
					analyser.frequencyBinCount / 3 / barCount,
				);

				for (let i = 0; i < barCount; i++) {
					const value = dataArray[i * step];

					// Keep the bars chunky by snapping their height to 8px blocks
					const rawHeight = (value / 255) * (chart.height * 0.7);
					const barHeight = Math.floor(rawHeight / 8) * 8;

					const x = chart.x + i * (barWidth + barGap);
					const y = baseline - barHeight;

					// Blue → green → yellow → purple
					if (value < 64) {
						ctx.fillStyle = "#6894b7"; // blue
					} else if (value < 128) {
						ctx.fillStyle = "#78b89a"; // green
					} else if (value < 192) {
						ctx.fillStyle = "#f1cc68"; // yellow
					} else {
						ctx.fillStyle = "#a78ee9"; // purple
					}

					ctx.fillRect(x, y, barWidth, barHeight);

					// Small horizontal gaps make each bar look pixelated
					ctx.fillStyle = "#f2f2eb";

					for (let segment = 0; segment < barHeight; segment += 8) {
						ctx.fillRect(x, y + segment, barWidth, 1);
					}
				}

			}

			function drawIdle() {
				const chart = drawVisualizerWindow();

				ctx.fillStyle = "#1a1625";
				ctx.fillRect(chart.x, chart.y, chart.width, chart.height);

				const baseline = chart.y + chart.height * 0.75;

				ctx.setLineDash([6, 4]);
				ctx.strokeStyle = "#414047";
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.moveTo(chart.x, baseline);
				ctx.lineTo(chart.x + chart.width, baseline);
				ctx.stroke();
				ctx.setLineDash([]);

				ctx.fillStyle = "#8272ad";
				ctx.font = "10px monospace";
				ctx.fillText(
					"♪ no signal",
					chart.x + 8,
					chart.y + chart.height - 9,
				);
			}

			async function startMic() {
				const stream = await navigator.mediaDevices.getUserMedia({
					audio: true,
					video: false,
				});
				audioCtx = new AudioContext();
				analyser = audioCtx.createAnalyser();
				analyser.fftSize = 256;

				source = audioCtx.createMediaStreamSource(stream);
				source.connect(analyser);

				const dataArray = new Uint8Array(analyser.frequencyBinCount);

				// animation loop
				function draw() {
					animFrameId = requestAnimationFrame(draw);
					analyser.getByteFrequencyData(dataArray);
					drawEqualizer(dataArray);
				}

				draw();

				// Picture-in-Picture API — capture canvas as video stream and pop it out
				const canvasStream = canvas.captureStream(30); // 30fps
				video.srcObject = canvasStream;
				await video.play();
				await video.requestPictureInPicture();
			}

			function stopVisualizer() {
				cancelAnimationFrame(animFrameId);
				if (audioCtx) audioCtx.close();
				if (document.pictureInPictureElement)
					document.exitPictureInPicture();
				drawIdle();
				isRunning = false;
				visualizerBtn.textContent = "▶";
				visualizerBtn.classList.remove("is-active");
			}

			visualizerBtn.addEventListener("click", async () => {
				if (isRunning) {
					stopVisualizer();
				} else {
					try {
						await startMic();
						isRunning = true;
						visualizerBtn.textContent = "⏸";
						visualizerBtn.classList.add("is-active");
					} catch (err) {
						console.error("Visualizer error:", err);
						alert(
							"Could not access microphone. Please allow microphone access.",
						);
					}
				}
			});

			video.addEventListener("leavepictureinpicture", () => {
				stopVisualizer();
			});

			// draw idle state on load
			drawIdle();
		</script>
	</body>
</html>
