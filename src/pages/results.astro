---
// @ts-nocheck
import "../styles/style.css";

export const prerender = false;

const discogsKey = import.meta.env.DISCOG_TOKEN;
const userName = "lisa_luijk";
const discogsURL = `https://api.discogs.com/users/${userName}/collection/folders/0/releases?token=${discogsKey}&per_page=100&sort=artist`;
const response = await fetch(discogsURL);
const data = await response.json();
const records = data.releases;

// source gpt
const url = Astro.url;
// const url = document.url;

// get data from url
const chosenGenres = url.searchParams.getAll("genres");
const time = url.searchParams.get("listenTime");

// filtering on genres
const filtered = records.filter((record) => {
	const recordGenres = record.basic_information.genres || [];
	return chosenGenres.some((g) => recordGenres.includes(g));
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Results</title>
	</head>
	<body>
		<div class="windowBox px-corners-m">
			<span class="px-corners-s">your_personal_playlist.mp3</span>
			<div class="px-corners-s content">
				<h1>Here is your record playlist!</h1>

				<p>
					A personalized playlist of <b>{time}</b> records with at least
					one of the following genres: <b>{chosenGenres.join(", ")}</b
					>.
				</p>

				<button id="visualizerBtn">♪ open visualizer</button>

				<!-- hidden canvas used to capture the stream for PiP -->
				<canvas id="visualizerCanvas" style="display:none;"></canvas>
				<video
					id="visualizerVideo"
					style="display:none;"
					muted
					playsinline></video>

				<!-- where the records get loaded in -->
				<ul id="recordList"></ul>
			</div>
		</div>

		<script define:vars={{ records, url, chosenGenres, time, filtered }}>
			// @ts-nocheck

			const recordsList = document.querySelector("#recordList");
			let displayRecords = records;

			const list = document.querySelector("#recordList");

			// aantal platen laten zien omzetten van string naar integer
			recordAmount = parseInt(time);

			// shuffelen door telkens twee records met elkaar te swappen en een soort deconstruct iets om code lines te besparen.
			function shuffle(arr) {
				// ... = spread operator?
				// used to make a copy otherwise you are referencing to the same array with different variables
				const copy = [...arr];

				// ga door de array heen en wissel telkens een record met een andere record
				for (let i = copy.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));

					// array destructuring assignment(?) basically scheelt lines of code omdat je het kan swappen terwijl het wel op elkaar berust zeg maar, beetje de css vibes met dat swappen
					[copy[i], copy[j]] = [copy[j], copy[i]];
				}

				return copy;
			}

			const shuffledRecords = shuffle(filtered);
			console.log(shuffledRecords);

			const selectedRecords = shuffledRecords.slice(0, recordAmount);

			selectedRecords.forEach((record) => {
				const li = document.createElement("li");

				const img = document.createElement("img");
				img.src = record.basic_information.cover_image;
				img.alt = record.basic_information.title;

				const info = document.createElement("div");
				info.classList.add("record-info");

				const titleInformation = document.createElement("div");
				titleInformation.classList.add("title-information");

				const title = document.createElement("h2");
				title.textContent = record.basic_information.title;

				const artist = document.createElement("p");
				artist.textContent = record.basic_information.artists
					?.map((artist) => artist.name)
					.join(", ");

				const year = document.createElement("p");
				year.textContent = record.basic_information.year;

				titleInformation.appendChild(title);
				titleInformation.appendChild(artist);
				titleInformation.appendChild(year);

				const genreInformation = document.createElement("div");
				genreInformation.classList.add("genre-information");

				const genres = document.createElement("p");
				genres.textContent =
					record.basic_information.genres?.join(", ");

				const genresLabel = document.createElement("strong");
				genresLabel.textContent = "genres:";

				genreInformation.appendChild(genresLabel);
				genreInformation.appendChild(genres);

				info.appendChild(titleInformation);
				info.appendChild(genreInformation);

				const imageContainer = document.createElement("div");
				imageContainer.classList.add("record-image");
				imageContainer.classList.add("px-corners-s");

				imageContainer.appendChild(img);

				li.appendChild(imageContainer);
				li.appendChild(info);

				list.appendChild(li);
			});
			// console.log(displayRecords);

			// get track duration
			// const masterURL = record.basic_information.master_url;
			// console.log(masterURL);

			// async function getTrackDuration() {
			// 	const masterResponse = await fetch(masterURL);
			// 	const masterData = await masterResponse.json();
			// 	const masterInformation = masterData.releases;
			// }

			// getTrackDuration();
			// console.log(masterInformation)

			// carrousel code

			// carrousel code
			// recordslist is container and recordslistitems are items
			//

			const recordsListItems =
				document.querySelectorAll("#recordList > *");

			console.log(recordsListItems);

			let ticking = false;

			function updateActive() {
				const isMobile =
					window.matchMedia("(max-width: 600px)").matches;

				const listRect = recordsList.getBoundingClientRect();

				let listCenter;

				if (isMobile) {
					listCenter = listRect.top + listRect.height / 2;
				} else {
					listCenter = listRect.left + listRect.width / 2;
				}

				recordsListItems.forEach((item) => {
					const itemRect = item.getBoundingClientRect();

					let itemCenter;

					if (isMobile) {
						itemCenter = itemRect.top + itemRect.height / 2;
					} else {
						itemCenter = itemRect.left + itemRect.width / 2;
					}

					const distance = Math.abs(listCenter - itemCenter);

					if (
						distance <
						(isMobile ? itemRect.height : itemRect.width) / 2
					) {
						item.classList.add("is-active");
					} else {
						item.classList.remove("is-active");
					}
				});

				ticking = false;
			}

			function requestUpdate() {
				if (!ticking) {
					requestAnimationFrame(updateActive);
					ticking = true;
				}
			}

			updateActive();

			recordsList.addEventListener("scroll", requestUpdate);

			// ==========================================================================
			// MARK: Visualizer — mic input (Web Audio API)
			// ==========================================================================

			const visualizerBtn = document.querySelector("#visualizerBtn");
			const canvas = document.querySelector("#visualizerCanvas");
			const video = document.querySelector("#visualizerVideo");
			const ctx = canvas.getContext("2d");

			canvas.width = 480;
			canvas.height = 270;

			let audioCtx, analyser, source;
			let isRunning = false;

			async function startMic() {
				// ask for mic permission and get the audio stream
				const stream = await navigator.mediaDevices.getUserMedia({
					audio: true,
					video: false,
				});

				// create audio context and analyser
				audioCtx = new AudioContext();
				analyser = audioCtx.createAnalyser();
				analyser.fftSize = 256; // how detailed the frequency data is

				// pipe the mic stream into the analyser
				source = audioCtx.createMediaStreamSource(stream);
				source.connect(analyser);

				console.log("Mic connected, analyser ready");
			}

			visualizerBtn.addEventListener("click", async () => {
				if (!isRunning) {
					try {
						await startMic();
						isRunning = true;
						visualizerBtn.textContent = "♪ close visualizer";
						visualizerBtn.classList.add("is-active");
					} catch (err) {
						console.error("Mic error:", err);
						alert(
							"Could not access microphone. Please allow microphone access.",
						);
					}
				}
			});
			
		</script>
	</body>
</html>
