---
// @ts-nocheck

import "../styles/general.css";
import "../styles/index.css";

// Discogs API 
const discogsToken = import.meta.env.DISCOG_TOKEN;
const userName = "lisa_luijk";

// url query
const discogsUrl =
	`https://api.discogs.com/users/${userName}/collection/folders/0/releases` +
	`?token=${discogsToken}&per_page=100&sort=artist`;

// Get my Discogs collection.
const response = await fetch(discogsUrl);

// Error if the request went wrong
// source: chatGPT
if (!response.ok) {
	throw new Error(
		`Could not load the Discogs collection. Status: ${response.status}`,
	);
}

// store the data I need in variables
const data = await response.json();
const records = data.releases ?? [];

// Get every genre from the collection, remove duplicates, then sort A–Z.
// flatMap combines the genres of all records into one array and removes duplicates.
// source: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/flatMap
// source: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/sort
const genres = [
	...new Set(
		records.flatMap((record) => {
			return record.basic_information.genres ?? [];
		}),
	),
].sort();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Your record playlist</title>
	</head>

	<body>
		<section class="windowBox px-corners-m">
			<span class="px-corners-s">playlist_creator.exe</span>

			<!--GET sends the selected values to the resultspage so I can use them there-->
			<form method="GET" action="/results" class="px-corners-s content">
				<h1>What do you want to listen to today?</h1>

				<label for="recordsAmount">
					How many records do you want to play?

					<input
						id="recordsAmount"
						name="listenTime"
						type="number"
						min="1"
						max={records.length}
						required
						class="px-corners-s"
					/>
				</label>

				<fieldset id="genreButtons">
					<legend>What genre(s) do you want to listen to?</legend>

					<!-- I use the data array I requested server side to make chackboxes with all the genres my records have -->
					{
						genres.map((genre) => (
							<label>
								<input
									type="checkbox"
									name="genres"
									value={genre}
									class="px-corners-s"
								/>
								{genre}
							</label>
						))
					}

				</fieldset>

				<button type="submit" class="px-corners-m">
					make me a playlist!
				</button>
			</form>
		</section>
	</body>
</html>