---
import "../styles/style.css";

const discogsKey = import.meta.env.DISCOG_TOKEN;
const userName = "lisa_luijk";
const discogsURL = `https://api.discogs.com/users/${userName}/collection/folders/0/releases?token=${discogsKey}&per_page=100&sort=artist`;
const response = await fetch(discogsURL);
const data = await response.json();
const records = data.releases;

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Your record playlist</title>
	</head>
	<body>
		<p>Hi welcome</p>

		<div class="windowBox px-corners-m">
			<span class="px-corners-s">playlist_creator.exe</span>
			<form method="GET" action="/results" class="px-corners-s content">
				<h1>What do you want to listen to today?</h1>
				<label for="amountTime">
					How many records do you want to play?
					<input id="amountTime" type="number" name="listenTime" class="px-corners-s"/>
				</label>

				<fieldset id="genreButtons">
					<legend>What genre(s) do you want to listen to?</legend>
				</fieldset>

				<button type="submit" class="px-corners-m">make me a playlist!</button>
			</form>
		</div>


		<script define:vars={{ records }}>
			// @ts-nocheck
			// get filter buttons!!!
			// get data to browser
			// const displayRecords = JSON.parse(`{JSON.stringify(records)}`);
			const displayRecords = records;

			console.log(displayRecords);

			// change buttoncontainer to fieldset
			const buttonContainer = document.querySelector("#genreButtons");
			// const list = document.querySelector("#recordList");

			// get genres
			const genres = [
				...new Set(
					displayRecords.flatMap(
						(record) => record.basic_information.genres || [],
					),
				),
			];

			// create filter buttons
			genres.forEach((genre) => {
				// source https://developer.mozilla.org/en-US/docs/Web/API/Document/createElement
				const checkbox = document.createElement("input");
				checkbox.type = "checkbox";
				checkbox.name = "genres";
				checkbox.value = genre;
				checkbox.classList.add("px-corners-s");

				const checkboxLabel = document.createElement("label");
				checkboxLabel.textContent = genre;

				// checkbox.addEventListener("click", () => {
				// 	renderList(genre);
				// });

				checkboxLabel.appendChild(checkbox);
				buttonContainer.appendChild(checkboxLabel);
			});


	
		</script>
	</body>
</html>
