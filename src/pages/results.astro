---
// @ts-nocheck

import "../styles/general.css";
import "../styles/results.css";

// to make sure the page only loads when the user requests it (I need the url parameters)
export const prerender = false;

// --------------------------------------------------------------------------
// Discogs: load my collection
// --------------------------------------------------------------------------

const discogsToken = import.meta.env.DISCOG_TOKEN;
const userName = "lisa_luijk";

const discogsUrl =
	`https://api.discogs.com/users/${userName}/collection/folders/0/releases` +
	`?token=${discogsToken}&per_page=100&sort=artist`;

const response = await fetch(discogsUrl);

// Error if the request went wrong
// source: chatGPT
if (!response.ok) {
	throw new Error(
		`Could not load the Discogs collection. Status: ${response.status}`,
	);
}

// Storing the data I need into variables
const data = await response.json();
const records = data.releases ?? [];

// --------------------------------------------------------------------------
// Get the URL parameters from the form on the index page
// --------------------------------------------------------------------------
const url = Astro.url;
const chosenGenres = url.searchParams.getAll("genres");
const requestedAmount = url.searchParams.get("listenTime");

// Keep records that have at least one selected genre.
// source: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/some
const filteredRecords = records.filter((record) => {
	const recordGenres = record.basic_information.genres ?? [];

	return chosenGenres.some((genre) => recordGenres.includes(genre));
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Your personal playlist</title>
	</head>

	<body>
		<div class="windowBox px-corners-m">
			<span class="px-corners-s">your_personal_playlist.mp3</span>

			<div class="px-corners-s content">
				<a href="/" class="backLink">◄ go back </a>

				<h1>Here is your record playlist!</h1>

				<p>
					A personalized playlist of <b>{requestedAmount}</b> records with
					at least one of the following genres:
					<b>{chosenGenres.join(", ")}</b>.
				</p>

				<!-- Opens and closes the audio visualizer. -->
				<button id="visualizerBtn" aria-label="Open visualizer"
					>▶</button
				>

				<!--The "canvas equalizer" is captured as a video stream for the picture in picture box. 
				Because pip does not support canvas and  the newer document pip is not supported in
				most browsers.-->
				<!-- Source: chatGPT helped me with finding away around that by having the canvas recorded 
				 as a video and have that in my pip -->
				<canvas id="visualizerCanvas" style="display: none;"></canvas>

				<video
					id="visualizerVideo"
					style="display: none;"
					muted
					playsinline
				>
				</video>

				<!-- Playlist records are added here with JavaScript. -->
				<ul id="recordList"></ul>
			</div>
		</div>

		<!-- I "import" the variables I made serverside to clientside -->
		<script define:vars={{ filteredRecords, requestedAmount }}>
			// @ts-nocheck

			// ==========================================================================
			// MARK: Playlist generation
			// ==========================================================================

			const recordList = document.querySelector("#recordList");

			// Convert the value from the URL from string into a number.
			// If it is missing or invalid, it falls back to zero records.
			const recordAmount = Number.parseInt(requestedAmount, 10) || 0;

			//  Returns a shuffled copy of an array. (You swap every record with a random record)
			//  ... = The original filteredRecords array remains unchanged.
			function shuffleRecords(records) {
				const shuffled = [...records];

				for (let index = shuffled.length - 1; index > 0; index--) {
					const randomIndex = Math.floor(Math.random() * (index + 1));

					// array destructuring assignment: you "swap" the two values
					// source: chat gpt
					[shuffled[index], shuffled[randomIndex]] = [
						shuffled[randomIndex],
						shuffled[index],
					];
				}

				return shuffled;
			}

			// Shuffle matching records and only keep the requested amount.
			const selectedRecords = shuffleRecords(filteredRecords).slice(
				0,
				recordAmount,
			);

			//  function to create a record card for the carousel.
			function createRecordCard(record) {
				const information = record.basic_information;

				const listItem = document.createElement("li");

				// Record cover
				const imageContainer = document.createElement("div");
				imageContainer.classList.add("record-image", "px-corners-s");

				const coverImage = information.cover_image;

				// if there is no cove image a simple record gets "drawn" with css instead
				if (coverImage) {
					const image = document.createElement("img");
					image.src = coverImage;
					image.alt = `Cover of ${information.title}`;
					image.loading = "lazy";

					imageContainer.appendChild(image);
				} else {
					const recordPlaceholder = document.createElement("div");
					recordPlaceholder.classList.add("record-placeholder");

					const recordTitle = document.createElement("span");
					recordTitle.textContent = information.title;

					recordPlaceholder.appendChild(recordTitle);
					imageContainer.appendChild(recordPlaceholder);
				}

				// Record information
				const recordInfo = document.createElement("div");
				recordInfo.classList.add("record-info");

				// title
				const titleInformation = document.createElement("div");
				titleInformation.classList.add("title-information");

				const title = document.createElement("h2");
				title.textContent = information.title;

				const artists = document.createElement("p");
				artists.textContent =
					information.artists
						?.map((artist) => artist.name)
						.join(", ") ?? "Unknown artist";

				const year = document.createElement("p");
				year.textContent = information.year || "Unknown year";

				titleInformation.append(title, artists, year);

				// genres
				const genreInformation = document.createElement("div");
				genreInformation.classList.add("genre-information");

				const genreLabel = document.createElement("strong");
				genreLabel.textContent = "genres:";

				const genres = document.createElement("p");
				genres.textContent =
					information.genres?.join(", ") ?? "Unknown";

				genreInformation.append(genreLabel, genres);
				recordInfo.append(titleInformation, genreInformation);

				// full item
				listItem.append(imageContainer, recordInfo);

				return listItem;
			}

			// Add all selected records to the page.
			selectedRecords.forEach((record) => {
				recordList.appendChild(createRecordCard(record));
			});

			// ==========================================================================
			// MARK: Carousel active item
			// ==========================================================================

			const recordListItems = document.querySelectorAll("#recordList > li");
			let isWaitingForAnimationFrame = false;

			// Gives the item closest to the carousel centre the "is-active" class.
			// I do this so I can add information when the record is active
			function updateActiveRecord() {

				const isMobile = window.matchMedia("(max-width: 600px)").matches;

				/*
				source: chatGPT
				On mobile, the first and final records cannot naturally reach the
				vertical centre without adding visible empty space.

				Instead, make the first record active at the top and the final
				record active at the bottom of the list.
				*/
				if (isMobile) {
					const isAtStart = recordList.scrollTop <= 1;

					const isAtEnd =
						Math.ceil(
							recordList.scrollTop + recordList.clientHeight,
						) >= recordList.scrollHeight;

					if (isAtStart) {
						recordListItems.forEach((item, index) => {
							item.classList.toggle("is-active", index === 0);
						});

						isWaitingForAnimationFrame = false;
						return;
					}

					if (isAtEnd) {
						recordListItems.forEach((item, index) => {
							const isLastItem = index === recordListItems.length - 1;

							item.classList.toggle("is-active", isLastItem);
						});

						isWaitingForAnimationFrame = false;
						return;
					}
				}

				// calculate center of the recordlist
				const listBounds = recordList.getBoundingClientRect();
				let listCentre;

				if (isMobile) {
					listCentre = listBounds.top + listBounds.height / 2;
				} else {
					listCentre = listBounds.left + listBounds.width / 2;
				}

				// Give record closest to that center active class
				recordListItems.forEach((item) => {
					const itemBounds = item.getBoundingClientRect();

					let itemCentre;
					let activeDistance;

					if (isMobile) {
						itemCentre = itemBounds.top + itemBounds.height / 2;
						activeDistance = itemBounds.height / 2;
					} else {
						itemCentre = itemBounds.left + itemBounds.width / 2;
						activeDistance = itemBounds.width / 2;
					}

					const distanceToCentre = Math.abs(listCentre - itemCentre);
					const isActive = distanceToCentre < activeDistance;

					item.classList.toggle("is-active", isActive);
				});

				isWaitingForAnimationFrame = false;
			}

			/*
			source: chatGPT (asked to make the scrolling smoother)
			Only one update is scheduled per animation frame while the user scrolls.
			This avoids unnecessarily running the function many times per frame.
			*/
			function requestActiveRecordUpdate() {
				if (isWaitingForAnimationFrame) {
					return;
				}

				isWaitingForAnimationFrame = true;
				requestAnimationFrame(updateActiveRecord);
			}

			updateActiveRecord();
			recordList.addEventListener("scroll", requestActiveRecordUpdate);

			// ==========================================================================
			// MARK: audio visualizer
			// ==========================================================================

			// inspiration sources: 
			// https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API/Visualizations_with_Web_Audio_API
			// https://www.youtube.com/watch?v=f0dwg99EVfo
			// https://www.youtube.com/watch?v=Yvz_axxWG4Y
			// https://developer.mozilla.org/en-US/docs/Web/API/Canvas_API/Tutorial
			
			const visualizerButton = document.querySelector("#visualizerBtn");
			const canvas = document.querySelector("#visualizerCanvas");
			const video = document.querySelector("#visualizerVideo");
			const context = canvas.getContext("2d");

			canvas.width = 480;
			canvas.height = 270;

			let audioContext;
			let analyser;
			let microphoneStream;
			let animationFrameId;
			let isVisualizerRunning = false;

			// Source: chat gpt
			// I could not style the window with css so I had ai draw me the styling in canvas
			// In document pip I could but it is not aviable for most browsers
			function drawVisualizerWindow() {
				const padding = 8;
				const labelHeight = 28;
				const gap = 5;

				// Window background and border
				context.fillStyle = "#f2f2eb";
				context.fillRect(0, 0, canvas.width, canvas.height);

				context.strokeStyle = "#414047";
				context.lineWidth = 2;
				context.strokeRect(1, 1, canvas.width - 2, canvas.height - 2);

				// Highlight: top and left
				context.strokeStyle = "#fdfdfd";
				context.beginPath();
				context.moveTo(3, canvas.height - 3);
				context.lineTo(3, 3);
				context.lineTo(canvas.width - 3, 3);
				context.stroke();

				// Shadow: bottom and right
				context.strokeStyle = "#ddd9d4";
				context.beginPath();
				context.moveTo(canvas.width - 3, 3);
				context.lineTo(canvas.width - 3, canvas.height - 3);
				context.lineTo(3, canvas.height - 3);
				context.stroke();

				// Blue application label
				context.fillStyle = "#6894b7";
				context.fillRect(
					padding,
					padding,
					canvas.width - padding * 2,
					labelHeight,
				);

				context.strokeStyle = "#414047";
				context.lineWidth = 1;
				context.strokeRect(
					padding,
					padding,
					canvas.width - padding * 2,
					labelHeight,
				);

				context.fillStyle = "#ffffff";
				context.font = "12px monospace";
				context.fillText("visualizer.exe", padding + 8, padding + 18);

				// How much "window" is left for the equalizer
				return {
					x: padding,
					y: padding + labelHeight + gap,
					width: canvas.width - padding * 2,
					height: canvas.height - (padding * 2 + labelHeight + gap),
				};
			}

			// Drawing the equalizer bars
			function drawEqualizer(audioData) {
				const chart = drawVisualizerWindow();

				context.fillStyle = "#f2f2eb";
				context.fillRect(chart.x, chart.y, chart.width, chart.height);

				const baseline = chart.y + chart.height * 0.75;

				// Dashed horizontal line behind the bars.
				context.setLineDash([6, 4]);
				context.strokeStyle = "#414047";
				context.lineWidth = 1;
				context.beginPath();
				context.moveTo(chart.x, baseline);
				context.lineTo(chart.x + chart.width, baseline);
				context.stroke();
				context.setLineDash([]);

				const barCount = 24;
				const barGap = 2;
				const barWidth = Math.floor(chart.width / barCount) - barGap;
				const frequencyStep = Math.floor(
					analyser.frequencyBinCount / 3 / barCount,
				);

				for (let index = 0; index < barCount; index++) {
					const value = audioData[index * frequencyStep];

					// Snap heights to 8px steps for the pixel-art effect.
					const rawHeight = (value / 255) * (chart.height * 0.7);
					const barHeight = Math.floor(rawHeight / 8) * 8;

					const x = chart.x + index * (barWidth + barGap);
					const y = baseline - barHeight;

					// Bar colour changes based on the sound level.
					if (value < 64) {
						context.fillStyle = "#6894b7"; // blue
					} else if (value < 128) {
						context.fillStyle = "#78b89a"; // green
					} else if (value < 192) {
						context.fillStyle = "#f1cc68"; // yellow
					} else {
						context.fillStyle = "#a78ee9"; // purple
					}

					context.fillRect(x, y, barWidth, barHeight);

					// One-pixel gaps create separated pixel blocks.
					context.fillStyle = "#f2f2eb";

					for (let segment = 0; segment < barHeight; segment += 8) {
						context.fillRect(x, y + segment, barWidth, 1);
					}
				}
			}

			/**
			 * Draws the visualizer before microphone input begins.
			 */
			function drawIdleVisualizer() {
				const chart = drawVisualizerWindow();

				context.fillStyle = "#1a1625";
				context.fillRect(chart.x, chart.y, chart.width, chart.height);

				const baseline = chart.y + chart.height * 0.75;

				context.setLineDash([6, 4]);
				context.strokeStyle = "#414047";
				context.lineWidth = 1;
				context.beginPath();
				context.moveTo(chart.x, baseline);
				context.lineTo(chart.x + chart.width, baseline);
				context.stroke();
				context.setLineDash([]);

				context.fillStyle = "#8272ad";
				context.font = "10px monospace";
				context.fillText(
					"♪ no signal",
					chart.x + 8,
					chart.y + chart.height - 9,
				);
			}

			/**
			 * Requests microphone permission, starts analysing audio,
			 * and opens the canvas inside a Picture-in-Picture window.
			 */
			async function startVisualizer() {
				microphoneStream = await navigator.mediaDevices.getUserMedia({
					audio: true,
					video: false,
				});

				audioContext = new AudioContext();
				analyser = audioContext.createAnalyser();
				analyser.fftSize = 256;

				const microphoneSource =
					audioContext.createMediaStreamSource(microphoneStream);

				microphoneSource.connect(analyser);

				const audioData = new Uint8Array(analyser.frequencyBinCount);

				function drawFrame() {
					animationFrameId = requestAnimationFrame(drawFrame);

					analyser.getByteFrequencyData(audioData);
					drawEqualizer(audioData);
				}

				drawFrame();

				// Turn the canvas drawing into a video stream for native PiP.
				const canvasStream = canvas.captureStream(30);

				video.srcObject = canvasStream;
				await video.play();
				await video.requestPictureInPicture();
			}

			/**
			 * Stops animation, microphone access and Picture-in-Picture.
			 */
			function stopVisualizer() {
				cancelAnimationFrame(animationFrameId);

				// Stop the actual microphone track, so the browser no longer
				// displays that the page is using the microphone.
				microphoneStream?.getTracks().forEach((track) => track.stop());
				microphoneStream = null;

				audioContext?.close();
				audioContext = null;

				// Only exit PiP if it is currently open.
				if (document.pictureInPictureElement) {
					document.exitPictureInPicture();
				}

				drawIdleVisualizer();

				isVisualizerRunning = false;
				visualizerButton.textContent = "▶";
				visualizerButton.setAttribute("aria-label", "Open visualizer");
				visualizerButton.classList.remove("is-active");
			}

			visualizerButton.addEventListener("click", async () => {
				if (isVisualizerRunning) {
					stopVisualizer();
					return;
				}

				try {
					await startVisualizer();

					isVisualizerRunning = true;
					visualizerButton.textContent = "⏸";
					visualizerButton.setAttribute(
						"aria-label",
						"Close visualizer",
					);
					visualizerButton.classList.add("is-active");
				} catch (error) {
					console.error("Visualizer error:", error);

					alert(
						"Could not access the microphone. Please allow microphone access.",
					);

					stopVisualizer();
				}
			});

			// Also stop mic access when the user closes the native PiP window.
			video.addEventListener("leavepictureinpicture", () => {
				if (isVisualizerRunning) {
					stopVisualizer();
				}
			});

			drawIdleVisualizer();
		</script>
	</body>
</html>
